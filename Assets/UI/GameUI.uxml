<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="FoodCounter" style="flex-grow: 1; position: absolute; bottom: 0; left: 0; right: 0; align-items: center; align-self: center; justify-content: center; flex-direction: row;">
        <ui:Label text="Food: &#10;" name="FoodLabel" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 255, 255); -unity-text-align: upper-center; font-size: 50%; position: relative; bottom: auto; left: auto; right: auto; align-items: auto; justify-content: space-between;"/>
        <ui:Label text="0" name="FoodAmount" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 255, 255); -unity-text-align: upper-center; font-size: 50%; position: relative; bottom: auto; left: auto; right: auto;"/>
    </ui:VisualElement>
    <ui:VisualElement name="GameOverPanel" style="flex-grow: 1; position: absolute; top: 0; right: 0; bottom: 0; left: 0; background-color: rgba(0, 0, 0, 0.78); -unity-text-align: upper-left; align-content: auto; align-self: auto; justify-content: space-evenly; align-items: stretch; display: flex; visibility: hidden; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; flex-basis: auto;">
        <ui:Label text="Game Over&#10;&#10;You traveled through&#10;[number] levels&#10;" name="GameOverMessage" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 255, 255); -unity-text-align: middle-center; font-size: 46px; align-items: center; justify-content: flex-start; align-self: center; align-content: auto; flex-wrap: wrap; white-space: pre-wrap; -unity-paragraph-spacing: 60px; word-spacing: 0; letter-spacing: 0; -unity-text-outline-width: 0; -unity-text-auto-size: none;"/>
        <ui:Label text="Press R to restart&#10;" name="GameOverMessageInstruction" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 255, 255); -unity-text-align: middle-center; font-size: 46px; align-items: center; justify-content: flex-start; align-self: center; align-content: auto; flex-wrap: wrap; white-space: pre-wrap; -unity-paragraph-spacing: 60px; word-spacing: 0; letter-spacing: 0; -unity-text-outline-width: 0; -unity-text-auto-size: none;"/>
    </ui:VisualElement>
</ui:UXML>
